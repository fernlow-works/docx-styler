{
	"name": "docx-styler",
	"version": "1.1.0",
	"description": "Export notes to Word (.docx) with real Word styles, on desktop and mobile, without Pandoc.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && npm run check:bundle",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"e2e": "xvfb-run -a --server-args='-screen 0 1280x900x24' node e2e/run.mjs",
		"check:bundle": "node build/check-bundle.mjs main.js"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.14.4",
		"playwright-core": "1.64.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"docx": "^9.14.0",
		"jszip": "^3.10.2",
		"marked": "^15.0.12"
	},
	"author": "Fernlow Works"
}
